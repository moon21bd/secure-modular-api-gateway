/**
 * JWK keystore used for JWE payload encryption and JWS access tokens
 * (see lib/tokenhandler.js).
 *
 * The real file is NOT committed -- it holds private keys. Generate one per
 * environment with node-jose and drop it in as resources/client.keystore.js:
 *
 *   const jose = require('node-jose')
 *   const store = jose.JWK.createKeyStore()
 *   await store.generate('RSA', 2048, { kid: 'client-1', use: 'enc' })
 *   console.log(JSON.stringify(store.toJSON(true)))
 *
 * `kid` matters: it is read from the JWE header to select which key decrypts
 * an inbound payload, so each API client gets its own key and a compromised
 * client key never exposes anyone else's traffic.
 */
module.exports = {
  keys: [
    // { kty: 'RSA', kid: 'client-1', use: 'enc', n: '...', e: 'AQAB', d: '...' }
  ]
}
